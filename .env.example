# Reference values for local development. Spring Boot does not load .env automatically;
# set these in your shell or IntelliJ run configuration.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=college_bus_tracking
DB_USERNAME=root
DB_PASSWORD=replace-with-your-local-mysql-password

# Replace with a securely generated secret of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://localhost:19006
SEED_DATA=true
SEED_ADMIN_EMAIL=admin@college.edu
SEED_ADMIN_PASSWORD=replace-before-use
